thub.com/users/dlanov","html_url":"https://github.com/dlanov","followers_url":"https://api.github.com/users/dlanov/followers","following_url":"https://api.github.com/users/dlanov/following{/other_user}","gists_url":"https://api.github.com/users/dlanov/gists{/gist_id}","starred_url":"https://api.github.com/users/dlanov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dlanov/subscriptions","organizations_url":"https://api.github.com/users/dlanov/orgs","repos_url":"https://api.github.com/users/dlanov/repos","events_url":"https://api.github.com/users/dlanov/events{/privacy}","received_events_url":"https://api.github.com/users/dlanov/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b2bf9ece6455b47462984638b169959c05009338","url":"https://api.github.com/repos/ros2/rcl/commits/b2bf9ece6455b47462984638b169959c05009338","html_url":"https://github.com/ros2/rcl/commit/b2bf9ece6455b47462984638b169959c05009338"}]},{"sha":"b2bf9ece6455b47462984638b169959c05009338","node_id":"C_kwDOAdpq29oAKGIyYmY5ZWNlNjQ1NWI0NzQ2Mjk4NDYzOGIxNjk5NTljMDUwMDkzMzg","commit":{"author":{"name":"Christophe Bedard","email":"bedard.christophe@gmail.com","date":"2026-10-05T11:19:04Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-05T11:19:04Z"},"message":"Switch rcl_yaml_param_parser from ament_cmake_ros to just ament_cmake (#1348)\n\nSmall dependency cleanup.\n\n`ament_cmake_ros` provides `ament_add_ros_isolated_*()` functions (and\nalso depends on `ament_cmake_ros_core`). However,\n`rcl_yaml_param_parser` doesn't use those functions; it strictly needs\n`ament_cmake_ros_core`'s C/CXX standard utilities in its tests.\n\nIt's worth noting that `rcl_yaml_param_parser` only uses\n`ament_cmake_ros_core` in its tests; the `rcl_yaml_param_parser` lib\ndoesn't target `ament_cmake_ros_core`'s `ament_ros_c_standard`. It's\nfine, because it gets it transitively through its dependency on\n`rcutils`, which uses `ament_cmake_ros_core::ament_ros_defaults`.\n\nSigned-off-by: Christophe Bedard <bedard.christophe@gmail.com>","tree":{"sha":"0ad2073d9caf0bb3b30a0f906ecbb3be20db6ab3","url":"https://api.github.com/repos/ros2/rcl/git/trees/0ad2073d9caf0bb3b30a0f906ecbb3be20db6ab3"},"url":"https://api.github.com/repos/ros2/rcl/git/commits/b2bf9ece6455b47462984638b169959c05009338","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqw4eoCRC1aQ7uu5UhlAAAO/MQAJaZH/mnHUmkRIskPqqbSK2S\n/ASzMr/m7El6BzE3PS8+IOV8SA2GV17w1hkj4hJSYIb7MKZ6ut5Q8uo64gusKacN\nA4PFREWcaccMbWlv1XzWMbcZ5btoI9hLVi5dKgQ74zdTEbB7j4fPpRdhnZXSp07f\nKFdUVJusZLJCn49B6SB9mX2uvJq2xwlBIcqE2k9RmXrUbT7ADih3LvzDwKQrDlp1\nC7VuaUkj6/a+edLwOx7kABIoqxXgp4oqJIA/4bDdNfBpbI5XkTGMr1u39S7O4eUV\n5v1iwMjqhjm/zGO2wWZY59W/EImJbBdyCD0PTfWqoSCTGpLdfre48gMeBncUYpnA\nfYb1cRfqtVO7KTqTx2uS/KlZstaHqgxQhAAGHiTDGbCE3M0pvTxXpf76u0WZ4Glg\nmzojdDrQPFuoRFqeVy4Zlgf7591vbg1MdCe1B2GeQ9yQw5j+zwN9G0zSH2jPSiLA\nVxECU1k47SvkZIe0blNhd7Ewqxk1A+yf+AyfEsBF8S6iPEgpoyUKB0zZKKkP0Q7/\ngZJH7jqxDYcwx73W92fR2lXzkaLcmtcoPySFv6pv54RCGb3G8og+3U0X4u27LibA\ntfXUeFXcRwUmGyHmRcisAIV56l1Qb94f8S/r9CnxI6Ky1fQJZhPMIqBN4p2u8nA/\nIewHsSDMl+a7F4fECoZ0\n=CgOl\n-----END PGP SIGNATURE-----\n","payload":"tree 0ad2073d9caf0bb3b30a0f906ecbb3be20db6ab3\nparent 7990d46a2e137e93d4dbe9d14e049ec40d97f91c\nauthor Christophe Bedard <bedard.christophe@gmail.com> 1791199144 -0700\ncommitter GitHub <noreply@github.com> 1791199144 +0200\n\nSwitch rcl_yaml_param_parser from ament_cmake_ros to just ament_cmake (#1348)\n\nSmall dependency cleanup.\n\n`ament_cmake_ros` provides `ament_add_ros_isolated_*()` functions (and\nalso depends on `ament_cmake_ros_core`). However,\n`rcl_yaml_param_parser` doesn't use those functions; it strictly needs\n`ament_cmake_ros_core`'s C/CXX standard utilities in its tests.\n\nIt's worth noting that `rcl_yaml_param_parser` only uses\n`ament_cmake_ros_core` in its tests; the `rcl_yaml_param_parser` lib\ndoesn't target `ament_cmake_ros_core`'s `ament_ros_c_standard`. It's\nfine, because it gets it transitively through its dependency on\n`rcutils`, which uses `ament_cmake_ros_core::ament_ros_defaults`.\n\nSigned-off-by: Christophe Bedard <bedard.christophe@gmail.com>","verified_at":"2026-10-05T11:19:05Z"}},"url":"https://api.github.com/repos/ros2/rcl/commits/b2bf9ece6455b47462984638b169959c05009338","html_url":"https://github.com/ros2/rcl/commit/b2bf9ece6455b47462984638b169959c05009338","comments_url":"https://api.github.com/repos/ros2/rcl/commits/b2bf9ece6455b47462984638b169959c05009338/comments","author":{"login":"christophebedard","id":3717345,"node_id":"MDQ6VXNlcjM3MTczNDU=","avatar_url":"https://avatars.githubusercontent.com/u/3717345?v=4","gravatar_id":"","url":"https://api.github.com/users/christophebedard","html_url":"https://github.com/christophebedard","followers_url":"https://api.github.com/users/christophebedard/followers","following_url":"https://api.github.com/users/christophebedard/following{/other_user}","gists_url":"https://api.