github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cc1508bf0c7f577313c58231f12723606d296d41","url":"https://api.github.com/repos/ros2/rclpy/commits/cc1508bf0c7f577313c58231f12723606d296d41","html_url":"https://github.com/ros2/rclpy/commit/cc1508bf0c7f577313c58231f12723606d296d41"}]},{"sha":"cc1508bf0c7f577313c58231f12723606d296d41","node_id":"C_kwDOAsXFmdoAKGNjMTUwOGJmMGM3ZjU3NzMxM2M1ODIzMWYxMjcyMzYwNmQyOTZkNDE","commit":{"author":{"name":"Tomoya Fujita","email":"fujita.tomoya@triorb.co.jp","date":"2026-10-05T08:02:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-05T08:02:37Z"},"message":"Allow overriding the entity class in every Node.create_* method (#1739)\n\nNode.create_publisher() has accepted a publisher_class argument since\nthe managed node implementation (#865), but none of the other create\nmethods did. Make the API consistent by adding the same optional\nkeyword to create_subscription(), create_client(), create_service(),\ncreate_timer() and create_guard_condition(). Each defaults to the\nexisting class, so behavior is unchanged for current callers.\n\nAlso document the previously undocumented publisher_class and\nqos_overriding_options parameters of create_publisher().\n\nAddresses the P.S. in #1677.\n\nSigned-off-by: Tomoya Fujita <fujita.tomoya@triorb.co.jp>\nCo-authored-by: Claude Fable 5.1 <noreply@anthropic.com>","tree":{"sha":"87f91c419d78ad40ab53338e849cb2529b59c803","url":"https://api.github.com/repos/ros2/rclpy/git/trees/87f91c419d78ad40ab53338e849cb2529b59c803"},"url":"https://api.github.com/repos/ros2/rclpy/git/commits/cc1508bf0c7f577313c58231f12723606d296d41","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqw1mdCRC1aQ7uu5UhlAAAHvMQADbwp7oTy+/WeixAXX3nB5dD\nnBHDV+26AMQiDbfgZ1yNO6tLYgxQbsBUr3P2TWvXN0+I4LxizYRvRPaT+20a0VNx\naGCyESP06LQKODzEl7ymyErbYvcGk571fodJ1sLf5AjQV7U8KG2zb9vqvrhUEymF\nIdkIEzPGftCzGNltGtiQ2Gzjqlrpi1iaNAKzrqsyr+hKRiIAklinXhSW8vE0kuIU\nARlWEL5qFNRhwD3hYD3Kj22VIP+Uh1Jva4p3QUE9n/jRNXTcGEOS6PG82ODOLyUO\nYMLXg2GmGXQab2JrbGIBLVhxlg6+23QhaNPAyqqdNEvZpVHDmwMvg8eptLXU7vwe\nK/1OhBqZeulxovU5GdP0nYQ+IReyqujaXhow0DdEO/ZXza2gdlG42LTGDbceyLiu\n//i/91eHatj+lnaE7We2dKwTcoxLrUrgRvClrijAML46Ww7gBeCkPa54+1EJPn0J\nrKh8ywyfv3dbmkX/KGU420FgniYP89NKkJ8JBVChFb7zHV1wiDriTTodJvncqGoD\nk6O6xfbut12PlBPVAS8/rjb4j2mjBokUj+SStl6FE5E6BCpzs8gjJ6ooSC+Thdr6\nFe3soKdgH6LcgmYj+DdE3ftl8tOqpyd36Qa3pG1VVOrJ00eWy4Uzkuc6tAn0qCG1\nOm3+761MM03oqBlkE7o2\n=X4yQ\n-----END PGP SIGNATURE-----\n","payload":"tree 87f91c419d78ad40ab53338e849cb2529b59c803\nparent c412c21df54a4c2029e68bd46816f2db6ef41aa4\nauthor Tomoya Fujita <fujita.tomoya@triorb.co.jp> 1791187357 +0900\ncommitter GitHub <noreply@github.com> 1791187357 +0200\n\nAllow overriding the entity class in every Node.create_* method (#1739)\n\nNode.create_publisher() has accepted a publisher_class argument since\nthe managed node implementation (#865), but none of the other create\nmethods did. Make the API consistent by adding the same optional\nkeyword to create_subscription(), create_client(), create_service(),\ncreate_timer() and create_guard_condition(). Each defaults to the\nexisting class, so behavior is unchanged for current callers.\n\nAlso document the previously undocumented publisher_class and\nqos_overriding_options parameters of create_publisher().\n\nAddresses the P.S. in #1677.\n\nSigned-off-by: Tomoya Fujita <fujita.tomoya@triorb.co.jp>\nCo-authored-by: Claude Fable 5.1 <noreply@anthropic.com>","verified_at":"2026-10-05T08:02:37Z"}},"url":"https://api.github.com/repos/ros2/rclpy/commits/cc1508bf0c7f577313c58231f12723606d296d41","html_url":"https://github.com/ros2/rclpy/commit/cc1508bf0c7f577313c58231f12723606d296d41","comments_url":"https://api.github.