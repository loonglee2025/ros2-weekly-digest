url/Afe6sRY7gmboptkv0yEn2cqTRpE.jpeg?dl=1\" title=\"1786123961068\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/f/e/fe06eb9c568cf159cffef2677878c5cce6433672_2_200x200.jpeg\" alt=\"1786123961068\" data-base62-sha1=\"Afe6sRY7gmboptkv0yEn2cqTRpE\" width=\"200\" height=\"200\" srcset=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/f/e/fe06eb9c568cf159cffef2677878c5cce6433672_2_200x200.jpeg, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/f/e/fe06eb9c568cf159cffef2677878c5cce6433672_2_300x300.jpeg 1.5x, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/f/e/fe06eb9c568cf159cffef2677878c5cce6433672_2_400x400.jpeg 2x\" data-dominant-color=\"C1C49A\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003e1786123961068\u003c/span\u003e\u003cspan class=\"informations\"\u003e800×800 76.5 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003cbr\u003e\n\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://us1.discourse-cdn.com/flex022/uploads/ros/original/3X/c/2/c2a5c495ce765e8b3f81ae9ce80a80c85d76194f.jpeg\" data-download-href=\"/uploads/short-url/rLVMGZBVw4WnySqMhowWer8hSyz.jpeg?dl=1\" title=\"trossen (1)\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/c/2/c2a5c495ce765e8b3f81ae9ce80a80c85d76194f_2_200x200.jpeg\" alt=\"trossen (1)\" data-base62-sha1=\"rLVMGZBVw4WnySqMhowWer8hSyz\" width=\"200\" height=\"200\" srcset=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/c/2/c2a5c495ce765e8b3f81ae9ce80a80c85d76194f_2_200x200.jpeg, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/c/2/c2a5c495ce765e8b3f81ae9ce80a80c85d76194f_2_300x300.jpeg 1.5x, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/c/2/c2a5c495ce765e8b3f81ae9ce80a80c85d76194f_2_400x400.jpeg 2x\" data-dominant-color=\"61618A\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003etrossen (1)\u003c/span\u003e\u003cspan class=\"informations\"\u003e1200×1200 194 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003eIn the lead up to ROSCon we have a bunch of fantastic events lined up in the Bay Area and online. Next Tuesday in San Francisco we’re holding a \u003ca href=\"https://luma.com/trossen-ROS\"\u003eTrossen X ROS Industry Night\u003c/a\u003e, on Wednesday we have our August Gazebo Community Meeting on \u003ca href=\"https://luma.com/1vzgflsv\"\u003eGym-Gazebo-Sim, a basic toolkit for using Gymnasium API in Gazebo\u003c/a\u003e, and \u003ca href=\"https://ruggedize.ai/\"\u003ethe Ruggedized agricultural technology and robotics conference\u003c/a\u003e will be held in Salinas on Wednesday and Thursday (I’ll be there giving a talk). The following week we’re holding \u003ca href=\"https://www.meetup.com/ros-by-the-bay/events/316104087/?eventOrigin=home_next_event_you_are_hosting\"\u003ea ROS By-The-Bay meetup at Bosch in Sunnyvale.\u003c/a\u003e\u003c/p\u003e\n\u003cbr\u003e\n\u003cdiv class=\"vimeo-onebox lazy-video-container\" data-video-id=\"1219082173?h=97f08fa4b0\u0026amp;app_id=122963\" data-video-title=\"Physical AI SIG\" data-provider-name=\"vimeo\"\u003e\n  \u003ca href=\"https://vimeo.com/1219082173/97f08fa4b0\" target=\"_blank\" rel=\"noopener\"\u003e\n    \u003cimg class=\"vimeo-thumbnail\" src=\"https://us1.discourse-cdn.com/flex022/uploads/ros/original/3X/5/c/5c467a9d088378dc1d8659ab39df188858c31e06.jpeg\" title=\"Physical AI SIG\" data-dominant-color=\"1F1F1F\" width=\"690\" height=\"388\"\u003e\n  \u003c/a\u003e\n\u003c/div\u003e\n\u003cp\u003e\nThe cat is out of the bag \u003ca href=\"https://osralliance.org/ros-keeps-evolving-via-physical-ai-sig/\"\u003eon the OSRA’s new Special Interest Group on Physical AI (SIG PAI).\u003c/a\u003e This week the SIG released a fantastic \u003ca href=\"https://github.com/ros-physical-ai/demos\"\u003edemo repo on Github that shows you how to integrate LeRobot, ROS, and multiple robotic simulators.\u003c/a\u003e The SIG PAI also laid out their roadmap for the next few years and how you can get involved.\u003c/p\u003e\n\u003cbr\u003e\n\u003cp\u003e\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://us1.discourse-cdn.com/flex022/uploads/ros/original/3X/e/c/ec229274de646bc23960dc3257254c4467483d21.jpeg\" data-download-href=\"/uploads/short-url/xGWKI4d7RCKofLkmZ39cMXBJ3Y5.jpeg?dl=1\" title=\"2026-08-17-poster\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/e/c/ec229274de646bc23960dc3257254c4467483d21_2_300x375.jpeg\" alt=\"2026-08-17-poster\" data-base62-sha1=\"xGWKI4d7RCKofLkmZ39cMXBJ3Y5\" width=\"300\" height=\"375\" srcset=\"https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/e/c/ec229274de646bc23960dc3257254c4467483d21_2_300x375.jpeg, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/e/c/ec229274de646bc23960dc3257254c4467483d21_2_450x562.jpeg 1.5x, https://us1.discourse-cdn.com/flex022/uploads/ros/optimized/3X/e/c/ec229274de646bc23960dc3257254c4467483d21_2_600x750.jpeg 2x\" data-dominant-color=\"59747A\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan c